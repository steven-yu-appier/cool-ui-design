+//* ============================================================================
+//* Toolbar Component
+//* ============================================================================
+
+interface SelectableToolbarProps {
+  children: (selectedIds: Set<string>) => React.ReactNode;
+  className?: string;
+  style?: React.CSSProperties;
+  offset?: { x?: number; y?: number };
+  asChild?: boolean;
+}
+
+Selectable.Toolbar = function SelectableToolbar({
+  children,
+  className,
+  style,
+  offset = {},
+  asChild,
+}: SelectableToolbarProps) {
+  const { selectedIds, isSelecting } = useSelectable();
+
+  if (selectedIds.size === 0 || isSelecting) return null;
+
+  const Comp = asChild ? Slot : "div";
+
+  return (
+    <Comp
+      className={cn(
+        !asChild &&
+          "absolute bottom-4 left-1/2 z-50 -translate-x-1/2 animate-in fade-in slide-in-from-bottom-2",
+        className,
+      )}
+      onPointerDown={(event) => event.stopPropagation()}
+      style={{
+        ...(offset.x != null && { marginLeft: offset.x }),
+        ...(offset.y != null && { marginBottom: offset.y }),
+        ...style,
+      }}
+    >
+      {children(selectedIds)}
+    </Comp>
+  );
+};
+
 export { Selectable };
 export type {
   Point,
   Rect,
   SelectionMode,
   SelectableProps,
   SelectableItemProps,
   SelectableGroupProps,
   SelectableOverlayProps,
+  SelectableToolbarProps,
 };
